[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.6
reloadable = true

[libraries]
linux.debug.x86_64     = "res://native/target/debug/libgame.so"
linux.release.x86_64   = "res://native/target/release/libgame.so"
windows.debug.x86_64   = "res://native/target/debug/game.dll"
windows.release.x86_64 = "res://native/target/release/game.dll"
macos.debug            = "res://native/target/debug/libgame.dylib"
macos.release          = "res://native/target/release/libgame.dylib"
macos.debug.arm64      = "res://native/target/debug/libgame.dylib"
macos.release.arm64    = "res://native/target/release/libgame.dylib"
